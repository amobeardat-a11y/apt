# ==============================================================================
# APTI BACKEND CONFIGURATION
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="APTI - Aptitude Test Tiếng Việt"
VERSION=1.0.0
API_V1_STR=/api/v1

# ==============================================================================
# DATABASE: NEON POSTGRESQL (SERVERLESS)
# ==============================================================================
# Điền URL kết nối Neon Postgres của bạn vào đây:
# DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-xyz.region.aws.neon.tech/neondb?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./apti.db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
SECRET_KEY=apti-super-secure-production-key-change-this-in-neon-deployment-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ==============================================================================
# RATE LIMITING & BRUTE FORCE PROTECTION
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ==============================================================================
# PAYMENT WEBHOOK
# ==============================================================================
PAYMENT_WEBHOOK_SECRET=apti-webhook-secret-key-neon-secure-2026

# ==============================================================================
# CORS
# ==============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8000","http://127.0.0.1:8000"]

# ==============================================================================
# INITIAL SUPER ADMIN SEED
# ==============================================================================
FIRST_SUPERUSER_EMAIL=admin@apti.vn
FIRST_SUPERUSER_PASSWORD=Apti@2026Admin!
FIRST_SUPERUSER_NAME="APTI Administrator"

