# ==============================================================================
# APTI BACKEND CONFIGURATION
# ==============================================================================

# Application Environment: development | production | testing
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="APTI - Aptitude Test Tiếng Việt"
VERSION=1.0.0
API_V1_STR=/api/v1

# ==============================================================================
# DATABASE: NEON POSTGRESQL (SERVERLESS)
# ==============================================================================
# Hướng dẫn cấu hình Neon Postgres:
# 1. Truy cập https://console.neon.tech và tạo project mới (hoặc chọn project có sẵn).
# 2. Tại Dashboard Neon, copy "Connection string" (chọn dạng asyncpg hoặc postgresql).
# 3. Dán URL vào bên dưới và đảm bảo có tiền tố 'postgresql+asyncpg://' cùng tham số '?ssl=require':
#
# Ví dụ Neon URL thực tế:
# DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_AbCd1234EfGh@ep-sweet-glade-a5b6c7d8.us-east-2.aws.neon.tech/neondb?ssl=require
#
# Mặc định (khi chưa cấu hình Neon, hệ thống dùng SQLite async để chạy ngay không lỗi):
DATABASE_URL=sqlite+aiosqlite:///./apti.db

# Neon Connection Pooling Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

# ==============================================================================
# SECURITY & AUTHENTICATION (BẢO MẬT & XÁC THỰC)
# ==============================================================================
# Khóa bí mật ký JWT - Hãy thay đổi bằng chuỗi ngẫu nhiên có độ dài tối thiểu 64 ký tự trên môi trường Production!
# Tạo chuỗi ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=apti-super-secure-production-key-change-this-in-neon-deployment-2026

# Thuật toán JWT và thời gian sống của Token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ==============================================================================
# RATE LIMITING & BRUTE FORCE PROTECTION (CHỐNG BRUTE FORCE & DDOS)
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ==============================================================================
# PAYMENT WEBHOOK SECURITY (XÁC THỰC THANH TOÁN)
# ==============================================================================
PAYMENT_WEBHOOK_SECRET=apti-webhook-secret-key-neon-secure-2026

# ==============================================================================
# CORS (DANH SÁCH DOMAIN FRONTEND ĐƯỢC PHÉP TRUY CẬP)
# ==============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8000","http://127.0.0.1:8000"]

# ==============================================================================
# INITIAL SUPER ADMIN SEED
# ==============================================================================
FIRST_SUPERUSER_EMAIL=admin@apti.vn
FIRST_SUPERUSER_PASSWORD=Apti@2026Admin!
FIRST_SUPERUSER_NAME="APTI Administrator"

